{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reasoning-graph:state.schema.json",
  "title": "Reasoning Graph State",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "default": []
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "default": []
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/factor"
      },
      "default": []
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "default": []
    },
    "goal_policy": {
      "$ref": "#/$defs/goalPolicy"
    },
    "goal_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goalGroup"
      }
    },
    "stop_policy": {
      "$ref": "#/$defs/stopPolicy"
    },
    "report": {
      "$ref": "#/$defs/report"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "view": {
      "$ref": "#/$defs/view"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "probability": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "scoreStipulation": {
      "description": "Goals, constraints, and tests are objectives, boundaries, or actions, not claims; they carry no score.",
      "not": {
        "required": [
          "score"
        ]
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "goal",
            "observation",
            "constraint",
            "hypothesis",
            "test",
            "candidate_solution"
          ]
        },
        "text": {
          "type": "string"
        },
        "short_text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "description": "The agent's own working memory for this node: caveats, what is left to check, why an inference holds."
        },
        "quote": {
          "type": "string",
          "description": "Verbatim excerpt from the source backing an observation, hedges included, so a reader can compare the claim with what the source says."
        },
        "not_run": {
          "type": "string",
          "pattern": "\\S",
          "description": "Test nodes only: why this check cannot be run here. A not-run test settles the test-result gate and must have no result observation."
        },
        "score": {
          "$ref": "#/$defs/score",
          "description": "Optional 1-5 tier for a claim: 1 very unlikely, 3 open, 5 well established. Omit it to take the default: observation 5, hypothesis and candidate 3. A claim with leads_to premises inherits their belief, and a score on it is a further local factor."
        },
        "belief": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Computed belief, written by the CLI on claim nodes so the state can be read as memory. Never authored: record patches reject it and validate fails when it no longer matches the graph."
        },
        "answer_kind": {
          "enum": [
            "exact_answer",
            "exact_method",
            "method_hypothesis",
            "clue_path",
            "blocker"
          ]
        },
        "exhausted": {
          "type": "boolean"
        },
        "exhaustion_reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "goal",
                  "constraint",
                  "test"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/scoreStipulation"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "candidate_solution"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "answer_kind"
            ]
          }
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "prior"
            ]
          },
          {
            "required": [
              "confidence"
            ]
          },
          {
            "required": [
              "probability"
            ]
          },
          {
            "required": [
              "posterior"
            ]
          }
        ]
      },
      "description": "Claims take one optional 1-5 score; the CLI maps it to a probability and computes belief. Goals, constraints, and tests carry no score. The removed prior/confidence/probability/posterior fields are rejected, not converted. Claims carry the computed belief the CLI writes; it is never authored."
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "from",
        "to",
        "type",
        "reasoning"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "requires",
            "supports",
            "contradicts",
            "prompts",
            "tested_by",
            "tests",
            "leads_to",
            "answers"
          ]
        },
        "score": {
          "$ref": "#/$defs/score",
          "description": "supports/contradicts only: optional 1-5 tier for how strongly the source bears on the target. Omit it to take the default 3."
        },
        "reasoning": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Explain why this directed relationship holds. Nonblank reasoning is required; one to five sentences is guidance, not a validation limit."
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "likelihood"
            ]
          },
          {
            "required": [
              "likelihood_ratio"
            ]
          },
          {
            "required": [
              "label"
            ]
          },
          {
            "required": [
              "hard"
            ]
          },
          {
            "required": [
              "mode"
            ]
          },
          {
            "required": [
              "strength"
            ]
          }
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "enum": [
                    "supports",
                    "contradicts"
                  ]
                }
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "score"
              ]
            }
          }
        }
      ]
    },
    "factorAggregation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "joint_probability",
            "likelihood"
          ]
        },
        "probability": {
          "$ref": "#/$defs/probability"
        },
        "if_target_true": {
          "$ref": "#/$defs/probability"
        },
        "if_target_false": {
          "$ref": "#/$defs/probability"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "joint_probability"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "probability"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "likelihood"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "if_target_true",
              "if_target_false"
            ]
          }
        }
      ],
      "not": {
        "required": [
          "likelihood_ratio"
        ]
      }
    },
    "factor": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "relation",
        "target",
        "inputs",
        "aggregation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "relation": {
          "enum": [
            "leads_to",
            "supports",
            "contradicts"
          ]
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "aggregation": {
          "$ref": "#/$defs/factorAggregation"
        },
        "reason": {
          "type": "string"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "likelihood_ratio"
            ]
          },
          {
            "required": [
              "effective_truth_cost"
            ]
          }
        ]
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "step",
        "action"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "enum": [
            "record",
            "refresh",
            "rank",
            "stop"
          ]
        },
        "best": {
          "$ref": "#/$defs/id"
        },
        "belief": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "node",
              "belief",
              "effective_truth_cost"
            ],
            "properties": {
              "node": {
                "$ref": "#/$defs/id"
              },
              "belief": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "effective_truth_cost": {
                "type": "number"
              }
            }
          }
        },
        "reason": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "solved",
            "candidate_count_met",
            "budget_exhausted",
            "blocked",
            "user_stopped",
            "inconclusive"
          ]
        },
        "add_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "add_edges": {
          "$ref": "#/$defs/stringList"
        },
        "update_factors": {
          "$ref": "#/$defs/stringList"
        },
        "updated_nodes": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "fields": {
                    "$ref": "#/$defs/stringList"
                  }
                }
              }
            ]
          }
        },
        "remove_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "remove_edges": {
          "$ref": "#/$defs/stringList"
        },
        "remove_factors": {
          "$ref": "#/$defs/stringList"
        },
        "updated_edges": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "fields": {
                    "$ref": "#/$defs/stringList"
                  }
                }
              }
            ]
          }
        },
        "graph_digest": {
          "type": "string",
          "minLength": 1,
          "description": "fingerprint of the graph the event left or judged"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "record"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "reason",
              "add_nodes",
              "add_edges",
              "graph_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "rank"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "best",
              "belief",
              "candidates"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "stop"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "reason",
              "outcome",
              "graph_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "refresh"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "graph_digest"
            ]
          }
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "update_premise_groups"
            ]
          },
          {
            "required": [
              "add_premise_groups"
            ]
          },
          {
            "required": [
              "add_factors"
            ]
          },
          {
            "required": [
              "no_reopen_reason"
            ]
          },
          {
            "required": [
              "exhaustion_reason"
            ]
          }
        ]
      }
    },
    "goalPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "accepted_goals": {
          "$ref": "#/$defs/stringList"
        },
        "preferred_goals": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "goalGroup": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "goals"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "goals": {
          "$ref": "#/$defs/stringList"
        },
        "exclusive": {
          "type": "boolean"
        }
      }
    },
    "stopPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "min_viable_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reportCandidate"
          }
        },
        "winning_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_verification": {
          "type": "string"
        }
      }
    },
    "reportCandidate": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "belief": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "truth_cost": {
          "type": "number"
        },
        "effective_truth_cost": {
          "type": "number"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "path_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "why": {
          "type": "string"
        },
        "next_test": {
          "type": "string"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "include_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "highlight_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "dim_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "title": {
          "type": "string"
        },
        "layout_hint": {
          "type": "string"
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "winning_path": {
          "$ref": "#/$defs/stringList"
        },
        "dimmed_branches": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  },
  "allOf": [
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "solutions"
            ]
          },
          {
            "required": [
              "premise_groups"
            ]
          },
          {
            "required": [
              "frontier"
            ]
          },
          {
            "required": [
              "search_policy"
            ]
          }
        ]
      }
    }
  ]
}
