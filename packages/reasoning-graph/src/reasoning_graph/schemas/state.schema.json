{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reasoning-graph:state.schema.json",
  "title": "Reasoning Graph State",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "default": []
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "default": []
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/factor"
      },
      "default": []
    },
    "goal_policy": {
      "$ref": "#/$defs/goalPolicy"
    },
    "goal_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goalGroup"
      }
    },
    "report": {
      "$ref": "#/$defs/report"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "view": {
      "$ref": "#/$defs/view"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^-]+$",
      "description": "No hyphen: an edge is named from-to."
    },
    "probability": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        },
        "answer": {
          "type": "string",
          "description": "The claim audit checks: it names one candidate per goal, by id or exact text. Empty while no answer is claimed."
        }
      }
    },
    "scoreStipulation": {
      "description": "Goals, constraints, and tests are objectives, boundaries, or actions, not claims; they carry no score.",
      "not": {
        "required": [
          "score"
        ]
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "enum": [
            "goal",
            "observation",
            "constraint",
            "hypothesis",
            "test",
            "candidate_solution"
          ]
        },
        "text": {
          "type": "string"
        },
        "short_text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "description": "The agent's own working memory for this node: caveats, what is left to check, why an inference holds."
        },
        "quote": {
          "type": "string",
          "description": "Verbatim excerpt from the source backing an observation, hedges included, so a reader can compare the claim with what the source says."
        },
        "not_run": {
          "type": "string",
          "pattern": "\\S",
          "description": "Test nodes only: why this check cannot be run here. A not-run test settles the test-result gate and must have no result observation."
        },
        "score": {
          "$ref": "#/$defs/score",
          "description": "Optional 1-5 tier for a claim: 1 very unlikely, 3 open, 5 well established. Omit it to take the default: observation 5, hypothesis and candidate 3. A claim with leads_to premises inherits their belief, and a score on it is a further local factor."
        },
        "answer_kind": {
          "enum": [
            "exact_answer",
            "exact_method",
            "method_hypothesis",
            "clue_path",
            "blocker"
          ]
        },
        "exhausted": {
          "type": "boolean"
        },
        "exhaustion_reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "goal",
                  "constraint",
                  "test"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/scoreStipulation"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "candidate_solution"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "answer_kind"
            ]
          }
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "prior"
            ]
          },
          {
            "required": [
              "confidence"
            ]
          },
          {
            "required": [
              "probability"
            ]
          },
          {
            "required": [
              "posterior"
            ]
          },
          {
            "required": [
              "belief"
            ]
          }
        ]
      },
      "description": "Claims take one optional 1-5 score; the CLI maps it to a probability. Goals, constraints, and tests carry no score. The removed prior/confidence/probability/posterior fields are rejected, not converted. Computed belief is not stored: it is computed when the graph is rendered."
    },
    "edge": {
      "type": "object",
      "description": "Identified by its ends, written from-to: one edge per ordered pair.",
      "additionalProperties": true,
      "required": [
        "from",
        "to",
        "type"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/nodeId"
        },
        "to": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "enum": [
            "requires",
            "supports",
            "contradicts",
            "prompts",
            "tested_by",
            "tests",
            "leads_to",
            "answers"
          ]
        },
        "score": {
          "$ref": "#/$defs/score",
          "description": "supports/contradicts only: optional 1-5 tier for how strongly the source bears on the target. Omit it to take the default 3."
        },
        "note": {
          "type": "string",
          "description": "Optional: why the link holds when the two texts do not make it obvious, or why its score departs from the default."
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "reasoning"
            ]
          },
          {
            "required": [
              "likelihood"
            ]
          },
          {
            "required": [
              "likelihood_ratio"
            ]
          },
          {
            "required": [
              "label"
            ]
          },
          {
            "required": [
              "hard"
            ]
          },
          {
            "required": [
              "mode"
            ]
          },
          {
            "required": [
              "strength"
            ]
          }
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "enum": [
                    "supports",
                    "contradicts"
                  ]
                }
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "score"
              ]
            }
          }
        }
      ]
    },
    "factor": {
      "type": "object",
      "additionalProperties": true,
      "description": "A correlation group: edges into one target that share a source or cause, so they count once at one combined score. The edges carry the relation and the target.",
      "required": [
        "id",
        "edges",
        "score"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "edges": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "description": "leads_to, supports, or contradicts edges of one type into one target, each named from-to. A grouped edge carries no score of its own."
        },
        "score": {
          "$ref": "#/$defs/score",
          "description": "Combined 1-5 score of the grouped edges: the joint probability tier of leads_to premises, or the joint evidence tier of supports/contradicts edges."
        },
        "note": {
          "type": "string"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "relation"
            ]
          },
          {
            "required": [
              "target"
            ]
          },
          {
            "required": [
              "inputs"
            ]
          },
          {
            "required": [
              "aggregation"
            ]
          },
          {
            "required": [
              "reason"
            ]
          },
          {
            "required": [
              "likelihood_ratio"
            ]
          },
          {
            "required": [
              "effective_truth_cost"
            ]
          }
        ]
      }
    },
    "goalPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "accepted_goals": {
          "$ref": "#/$defs/stringList"
        },
        "preferred_goals": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "goalGroup": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "goals"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "goals": {
          "$ref": "#/$defs/stringList"
        },
        "exclusive": {
          "type": "boolean"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reportCandidate"
          }
        },
        "winning_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_verification": {
          "type": "string"
        }
      }
    },
    "reportCandidate": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "path_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "why": {
          "type": "string"
        },
        "next_test": {
          "type": "string"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "belief"
            ]
          },
          {
            "required": [
              "truth_cost"
            ]
          },
          {
            "required": [
              "effective_truth_cost"
            ]
          },
          {
            "required": [
              "weight"
            ]
          }
        ]
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "include_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "highlight_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "dim_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "title": {
          "type": "string"
        },
        "layout_hint": {
          "type": "string"
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "winning_path": {
          "$ref": "#/$defs/stringList"
        },
        "dimmed_branches": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  },
  "allOf": [
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "solutions"
            ]
          },
          {
            "required": [
              "premise_groups"
            ]
          },
          {
            "required": [
              "frontier"
            ]
          },
          {
            "required": [
              "search_policy"
            ]
          },
          {
            "required": [
              "stop_policy"
            ]
          },
          {
            "required": [
              "events"
            ]
          }
        ]
      }
    }
  ]
}
