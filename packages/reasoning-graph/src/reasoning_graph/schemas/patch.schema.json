{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reasoning-graph:patch.schema.json",
  "title": "Reasoning Graph Expansion Patch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/node"
      }
    },
    "update_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "set"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "set": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true,
            "not": {
              "required": [
                "id"
              ]
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/edge"
      }
    },
    "frontier": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/frontierItem"
      }
    },
    "update_factors": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/factor"
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/factor"
      }
    },
    "no_new_work_reason": {
      "type": "string"
    },
    "rank": {
      "type": "boolean"
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    },
    "stop_outcome": {
      "enum": [
        "solved",
        "candidate_threshold_met",
        "candidate_count_met",
        "frontier_exhausted",
        "budget_exhausted",
        "blocked",
        "user_stopped",
        "inconclusive"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "stop_reason"
        ]
      },
      "then": {
        "required": [
          "stop_outcome"
        ]
      }
    },
    {
      "not": {
        "required": [
          "factors",
          "update_factors"
        ]
      }
    }
  ]
}
