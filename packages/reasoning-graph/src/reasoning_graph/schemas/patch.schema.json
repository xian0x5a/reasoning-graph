{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reasoning-graph:patch.schema.json",
  "title": "Reasoning Graph Expansion Patch",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "summary": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/edge"
      }
    },
    "frontier": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/frontierItem"
      }
    },
    "update_premise_groups": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/premiseGroup"
      }
    },
    "premise_groups": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/premiseGroup"
      }
    },
    "update_factors": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/factor"
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/factor"
      }
    },
    "updated_nodes": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "no_new_work_reason": {
      "type": "string"
    },
    "under_branching_reason": {
      "type": "string"
    },
    "existing_sibling_frontier": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rank": {
      "type": "boolean"
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    },
    "stop_outcome": {
      "enum": [
        "solved",
        "candidate_threshold_met",
        "candidate_count_met",
        "frontier_exhausted",
        "budget_exhausted",
        "blocked",
        "user_stopped",
        "inconclusive"
      ]
    },
    "outcome": {
      "enum": [
        "solved",
        "candidate_threshold_met",
        "candidate_count_met",
        "frontier_exhausted",
        "budget_exhausted",
        "blocked",
        "user_stopped",
        "inconclusive"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "stop_reason"
        ]
      },
      "then": {
        "required": [
          "stop_outcome"
        ]
      }
    }
  ],
  "not": {
    "anyOf": [
      {
        "required": [
          "add_node_objects"
        ]
      },
      {
        "required": [
          "add_edge_objects"
        ]
      },
      {
        "required": [
          "add_frontier_objects"
        ]
      },
      {
        "required": [
          "add_premise_group_objects"
        ]
      },
      {
        "required": [
          "add_factor_objects"
        ]
      },
      {
        "required": [
          "no_reopen_reason"
        ]
      },
      {
        "required": [
          "solution"
        ]
      },
      {
        "required": [
          "solution_node"
        ]
      },
      {
        "required": [
          "stop"
        ]
      }
    ]
  }
}
