{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reasoning-graph:state.schema.json",
  "title": "Reasoning Graph State",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "default": []
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "default": []
    },
    "frontier": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frontierItem"
      },
      "default": []
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/factor"
      },
      "default": []
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "default": []
    },
    "goal_policy": {
      "$ref": "#/$defs/goalPolicy"
    },
    "goal_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goalGroup"
      }
    },
    "stop_policy": {
      "$ref": "#/$defs/stopPolicy"
    },
    "branch_policy": {
      "$ref": "#/$defs/branchPolicy"
    },
    "search_policy": {
      "$ref": "#/$defs/searchPolicy"
    },
    "report": {
      "$ref": "#/$defs/report"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "view": {
      "$ref": "#/$defs/view"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "probability": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "autoNumber": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "const": "auto"
        },
        {
          "type": "null"
        }
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "goal",
            "evidence",
            "constraint",
            "derived",
            "assumption",
            "test",
            "candidate_solution"
          ]
        },
        "text": {
          "type": "string"
        },
        "short_text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "prior": {
          "$ref": "#/$defs/probability"
        },
        "confidence": {
          "$ref": "#/$defs/probability"
        },
        "probability": {
          "$ref": "#/$defs/probability"
        },
        "posterior": {
          "$ref": "#/$defs/probability"
        },
        "answer_kind": {
          "enum": [
            "exact_answer",
            "exact_method",
            "method_hypothesis",
            "clue_path",
            "blocker"
          ]
        },
        "clue_family": {
          "type": "boolean"
        },
        "salience": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exhausted": {
          "type": "boolean"
        },
        "exhaustion_reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "candidate_solution"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "answer_kind": {
                "enum": [
                  "exact_answer",
                  "exact_method",
                  "method_hypothesis",
                  "clue_path",
                  "blocker"
                ]
              }
            }
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "prior"
          ]
        },
        {
          "required": [
            "confidence"
          ]
        },
        {
          "required": [
            "probability"
          ]
        },
        {
          "required": [
            "posterior"
          ]
        }
      ],
      "description": "Every node, including derived nodes, requires an explicit local probability or calibrated posterior in (0, 1]."
    },
    "likelihood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "if_target_true",
        "if_target_false"
      ],
      "properties": {
        "if_target_true": {
          "$ref": "#/$defs/probability"
        },
        "if_target_false": {
          "$ref": "#/$defs/probability"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "from",
        "to",
        "type",
        "reasoning"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "requires",
            "supports",
            "contradicts",
            "prompts",
            "tested_by",
            "tests",
            "leads_to",
            "answers"
          ]
        },
        "likelihood": {
          "$ref": "#/$defs/likelihood"
        },
        "likelihood_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reasoning": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "format": "reasoning-sentences",
          "description": "Explain this directed relationship in one to five sentences. The CLI enforces the reasoning-sentences format."
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "likelihood",
              "likelihood_ratio"
            ]
          },
          {
            "required": [
              "label"
            ]
          },
          {
            "required": [
              "hard"
            ]
          },
          {
            "required": [
              "mode"
            ]
          },
          {
            "required": [
              "strength"
            ]
          }
        ]
      }
    },
    "factorAggregation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "joint_probability",
            "likelihood"
          ]
        },
        "probability": {
          "$ref": "#/$defs/probability"
        },
        "if_target_true": {
          "$ref": "#/$defs/probability"
        },
        "if_target_false": {
          "$ref": "#/$defs/probability"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "joint_probability"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "probability"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "likelihood"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "if_target_true",
              "if_target_false"
            ]
          }
        }
      ],
      "not": {
        "required": [
          "likelihood_ratio"
        ]
      }
    },
    "factor": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "relation",
        "target",
        "inputs",
        "aggregation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "relation": {
          "enum": [
            "leads_to",
            "supports",
            "contradicts"
          ]
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "aggregation": {
          "$ref": "#/$defs/factorAggregation"
        },
        "reason": {
          "type": "string"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "likelihood_ratio"
            ]
          },
          {
            "required": [
              "effective_truth_cost"
            ]
          }
        ]
      }
    },
    "costComponents": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "truth": {
          "$ref": "#/$defs/autoNumber"
        },
        "uncertainty": {
          "$ref": "#/$defs/autoNumber"
        },
        "verification": {
          "type": "number"
        },
        "effort_budget": {
          "type": "number"
        },
        "resource_budget": {
          "type": "number"
        },
        "compute_budget": {
          "type": "number"
        },
        "reasoning_complexity": {
          "type": "number"
        },
        "constraint_tension": {
          "type": "number"
        }
      }
    },
    "frontierItem": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "node"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "node": {
          "$ref": "#/$defs/id"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "related": {
          "$ref": "#/$defs/stringList"
        },
        "scratch": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "active_assumptions": {
          "$ref": "#/$defs/stringList"
        },
        "scope": {},
        "params": {},
        "budget": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 0
            },
            "max_seconds": {
              "type": "number",
              "minimum": 0
            },
            "max_items": {
              "type": "integer",
              "minimum": 0
            },
            "max_sources": {
              "type": "integer",
              "minimum": 0
            },
            "stop_after": {
              "type": "string"
            }
          }
        },
        "cost_components": {
          "$ref": "#/$defs/costComponents"
        },
        "cost": {
          "$ref": "#/$defs/costComponents"
        },
        "estimated_remaining_cost": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "truth_cost": {
          "type": "number"
        },
        "work_cost": {
          "type": "number"
        },
        "base_search_cost": {
          "type": "number"
        },
        "heuristic_cost": {
          "type": "number"
        },
        "search_cost": {
          "type": "number"
        },
        "step_cost": {
          "type": "number"
        },
        "step_truth_cost": {
          "type": "number"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "path_cost"
            ]
          },
          {
            "required": [
              "next_action"
            ]
          },
          {
            "required": [
              "expansion_hint"
            ]
          },
          {
            "required": [
              "context"
            ]
          },
          {
            "required": [
              "additional_info"
            ]
          },
          {
            "required": [
              "focus"
            ]
          }
        ]
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "step",
        "action"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "enum": [
            "init",
            "seed",
            "pop",
            "assign",
            "expand",
            "supersede",
            "rank",
            "stop"
          ]
        },
        "frontier": {
          "$ref": "#/$defs/stringList"
        },
        "item": {
          "$ref": "#/$defs/id"
        },
        "replacement": {
          "$ref": "#/$defs/id"
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "probe": {
          "$ref": "#/$defs/id"
        },
        "concurrency_group": {
          "type": "string",
          "minLength": 1
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "node": {
          "$ref": "#/$defs/id"
        },
        "best": {
          "$ref": "#/$defs/id"
        },
        "cost": {
          "type": "number"
        },
        "belief": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "node",
              "belief",
              "effective_truth_cost"
            ],
            "properties": {
              "node": {
                "$ref": "#/$defs/id"
              },
              "belief": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "effective_truth_cost": {
                "type": "number"
              }
            }
          }
        },
        "reason": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "solved",
            "candidate_threshold_met",
            "candidate_count_met",
            "frontier_exhausted",
            "budget_exhausted",
            "blocked",
            "user_stopped",
            "inconclusive"
          ]
        },
        "add_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "add_edges": {
          "$ref": "#/$defs/stringList"
        },
        "add_frontier": {
          "$ref": "#/$defs/stringList"
        },
        "update_factors": {
          "$ref": "#/$defs/stringList"
        },
        "updated_nodes": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "fields": {
                    "$ref": "#/$defs/stringList"
                  }
                }
              }
            ]
          }
        },
        "updated_node_snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "before"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "before": {
                "type": "object"
              }
            }
          }
        },
        "updated_factor_snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "before"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "before": {
                "anyOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "no_new_work_reason": {
          "type": "string"
        },
        "under_branching_reason": {
          "type": "string"
        },
        "existing_sibling_frontier": {
          "$ref": "#/$defs/stringList"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "init"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "frontier"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "seed"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "reason",
              "add_nodes",
              "add_edges",
              "add_frontier"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "pop"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "item",
              "cost"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "assign"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "item"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "expand"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "item",
              "add_nodes",
              "add_edges",
              "add_frontier"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "supersede"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "item",
              "replacement",
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "rank"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "best",
              "belief",
              "candidates"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "stop"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "reason",
              "outcome"
            ]
          }
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "update_premise_groups"
            ]
          },
          {
            "required": [
              "add_premise_groups"
            ]
          },
          {
            "required": [
              "add_factors"
            ]
          },
          {
            "required": [
              "no_reopen_reason"
            ]
          },
          {
            "required": [
              "exhaustion_reason"
            ]
          }
        ]
      }
    },
    "goalPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "accepted_goals": {
          "$ref": "#/$defs/stringList"
        },
        "preferred_goals": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "goalGroup": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "goals"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "goals": {
          "$ref": "#/$defs/stringList"
        },
        "exclusive": {
          "type": "boolean"
        }
      }
    },
    "stopPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "min_viable_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "belief_threshold": {
          "$ref": "#/$defs/probability"
        },
        "max_live_frontier_items": {
          "type": "integer",
          "minimum": 0
        },
        "require_frontier_exhausted_for_epistemic_stop": {
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        }
      }
    },
    "branchPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "high_salience_min_children": {
          "type": "integer",
          "minimum": 0
        },
        "low_prior_wildcard_required": {
          "type": "boolean"
        },
        "enforce_on": {
          "enum": [
            "exhaustion_stop",
            "always"
          ]
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        }
      }
    },
    "searchPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "estimated_remaining_weight": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "max_probe_concurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reportCandidate"
          }
        },
        "winning_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_verification": {
          "type": "string"
        }
      }
    },
    "reportCandidate": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "belief": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "truth_cost": {
          "type": "number"
        },
        "effective_truth_cost": {
          "type": "number"
        },
        "search_cost": {
          "type": "number"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "path_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "why": {
          "type": "string"
        },
        "next_test": {
          "type": "string"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "include_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "highlight_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "dim_nodes": {
          "$ref": "#/$defs/stringList"
        },
        "title": {
          "type": "string"
        },
