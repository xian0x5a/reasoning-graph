{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reasoning-graph:patch.schema.json",
  "title": "Reasoning Graph Record Patch",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "answer": {
      "type": "string",
      "description": "Sets summary.answer, the claim audit checks; an empty string withdraws it."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/node"
      }
    },
    "update_nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldUpdate"
      }
    },
    "remove_nodes": {
      "$ref": "#/$defs/idList",
      "description": "also removes every edge touching a removed node"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/edge"
      }
    },
    "update_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldUpdate"
      }
    },
    "remove_edges": {
      "$ref": "#/$defs/idList"
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/factor"
      }
    },
    "remove_factors": {
      "$ref": "#/$defs/idList"
    }
  },
  "$defs": {
    "fieldUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "set": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "not": {
            "required": [
              "id"
            ]
          }
        },
        "unset": {
          "allOf": [
            {
              "$ref": "#/$defs/idList"
            },
            {
              "not": {
                "contains": {
                  "const": "id"
                }
              }
            }
          ],
          "description": "field names to remove"
        }
      },
      "anyOf": [
        {
          "required": [
            "set"
          ]
        },
        {
          "required": [
            "unset"
          ]
        }
      ]
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
