{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reasoning-graph:patch.schema.json",
  "title": "Reasoning Graph Record Patch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reason": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/node"
      }
    },
    "update_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "set"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "set": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true,
            "not": {
              "required": [
                "id"
              ]
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/edge"
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "state.schema.json#/$defs/factor"
      }
    }
  }
}
